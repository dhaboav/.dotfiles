layout {
  gaps 8
  background-color "transparent"
  center-focused-column "never"

  default-column-width {
    proportion 0.5
  }

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }

  preset-window-heights {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }

  border {
    off
    width 2
  }

  focus-ring {
    width 2
  }

  shadow {
    softness 30
    spread 5
    offset x=0 y=5
    color "#0007"
  }
}
