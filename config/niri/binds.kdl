// LAST UPDATE: SATURDAY, 31 OCTOBER 2026 02:59 A.M. (UTC)

binds {
  Mod+Shift+Slash    { show-hotkey-overlay; } //--help
  Mod+Shift+E        { quit; } // Exit Niri
  Mod+O repeat=false { toggle-overview; }
  
  // === System Controls ===
  Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
  Mod+Shift+P { power-off-monitors; }
  Mod+Ctrl+P hotkey-overlay-title="Power Menu: Toggle" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
  Mod+Alt+L hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "lock" "lock"; }

  // === Application Launchers ===
  Mod+T hotkey-overlay-title="Terminal"    { spawn "alacritty"; }
  Mod+E hotkey-overlay-title="Files"       { spawn "nautilus"; }
  Mod+Delete hotkey-overlay-title="Trash"  { spawn "nautilus" "trash:///"; }
  Mod+B hotkey-overlay-title="Browser"     { spawn "firefox"; }
  Mod+C hotkey-overlay-title="VS Code"     { spawn "code"; }

  // === DMS Related Launchers ===
  Mod+Comma hotkey-overlay-title="Settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
  Mod+D hotkey-overlay-title="Search"       { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
  Mod+Y hotkey-overlay-title="Wallpapers"   { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; } 
  Ctrl+Shift+Escape hotkey-overlay-title="Task Manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }

  // Maybe usefull?
  Mod+A hotkey-overlay-title="Media"   { spawn "dms" "ipc" "call" "dash" "toggle" "media"; }
  Mod+N hotkey-overlay-title="Notepad" { spawn "dms" "ipc" "call" "notepad" "toggle"; }  
  Mod+K hotkey-overlay-title="Clipboard Manager" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
  Mod+Ctrl+N hotkey-overlay-title="Notification" { spawn "dms" "ipc" "call" "notifications" "toggle"; }

  // === Focus Navigation ===
  Mod+Up    { focus-window-up; }
  Mod+Left  { focus-column-left; }
  Mod+Right { focus-column-right; }
  Mod+Down  { focus-window-down; }

  // === Window Management ===
  Mod+Q repeat=false { close-window; }
  Mod+F       { maximize-column; }
  Mod+Shift+F { fullscreen-window; }
  Mod+V       { toggle-window-floating; }
  Mod+Shift+V { switch-focus-between-floating-and-tiling; }
  Mod+W       { toggle-column-tabbed-display; }

  // === Window Movement ===
  Mod+Shift+Up    { move-window-up; }
  Mod+Shift+Left  { move-column-left; }
  Mod+Shift+Right { move-column-right; }
  Mod+Shift+Down  { move-window-down; }

  // === Column Navigation ===
  Mod+Home { focus-column-first; }
  Mod+End  { focus-column-last; }
  Mod+Shift+Home { move-column-to-first; }
  Mod+Shift+End  { move-column-to-last; }
  
  // === Column Management ===
  Mod+BracketLeft  { consume-or-expel-window-left; }
  Mod+BracketRight { consume-or-expel-window-right; }
  
  /// === Numbered Workspaces ===
  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  
  // === Move to Numbered Workspaces ===
  Mod+Shift+1 { move-column-to-workspace 1; }
  Mod+Shift+2 { move-column-to-workspace 2; }
  Mod+Shift+3 { move-column-to-workspace 3; }
  Mod+Shift+4 { move-column-to-workspace 4; }
  Mod+Shift+5 { move-column-to-workspace 5; }
  Mod+Shift+6 { move-column-to-workspace 6; }
  Mod+Shift+7 { move-column-to-workspace 7; }
  Mod+Shift+8 { move-column-to-workspace 8; }
  Mod+Shift+9 { move-column-to-workspace 9; }

  // === Move Workspaces ===
  Mod+Shift+Page_Up   { move-workspace-up; }
  Mod+Shift+Page_Down { move-workspace-down; }

  // === Workspace Management ===
  Mod+M       { move-window-to-workspace-down; } 
  Mod+Shift+M { move-window-to-workspace-up; }  

  // ========================================

  // === Sizing & Layout ===
  Mod+R { switch-preset-column-width; }
  Mod+Shift+R { switch-preset-window-height; }
  Mod+Ctrl+R { reset-window-height; }

  // === Manual Sizing ===
  Mod+Minus { set-column-width "-10%"; }
  Mod+Equal { set-column-width "+10%"; }
  Mod+Shift+Minus { set-window-height "-10%"; }
  Mod+Shift+Equal { set-window-height "+10%"; }
  
  // === Brightness Controls ===
  XF86MonBrightnessUp allow-when-locked=true   { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
  XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }

  // === Audio Controls ===
  XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
  XF86AudioMute allow-when-locked=true        { spawn "dms" "ipc" "call" "audio" "mute"; }
  Ctrl+F7 allow-when-locked=true { spawn "dms" "ipc" "call" "mic" "mute" ; } // XF86AudioMicMute not work?
  XF86AudioPlay allow-when-locked=true  { spawn "dms" "ipc" "call" "mpris" "playPause" ; }
  XF86AudioPause allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
  XF86AudioPrev allow-when-locked=true  { spawn "dms" "ipc" "call" "mpris" "previous"; }
  XF86AudioNext allow-when-locked=true  { spawn "dms" "ipc" "call" "mpris" "next"; }

  // === Screenshot ===
  Print hotkey-overlay-title="SS-Region"          { spawn "dms" "screenshot"; }
  Ctrl+Print hotkey-overlay-title="SS-Fullscreen" { spawn "dms" "screenshot" "full"; }
  Alt+Print hotkey-overlay-title="SS-Window"      { spawn "dms" "screenshot" "window"; } //Niri notif trigger too?

  // ========================================

  // === Mouse Wheel Navigation ===
  Mod+WheelScrollUp cooldown-ms=150   { focus-workspace-up; }
  Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }

  Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
  Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }

  Mod+Shift+WheelScrollUp        { focus-column-left; }
  Mod+Shift+WheelScrollDown      { focus-column-right; }

  Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }
  Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
}